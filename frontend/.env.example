# API: в dev и на Vercel используется same-origin /api (Vite proxy → localhost:8080/v1).
# Явный override только если нужен другой backend:
# VITE_API_BASE=http://127.0.0.1:8080/v1

# Запасной флаг: показать кнопку Google, если /auth/config временно недоступен (Vercel Dashboard).
# VITE_GOOGLE_AUTH_ENABLED=true

# Прямой Render (fallback в getApiBase, если /api на Vercel не отвечает JSON).
# VITE_CLOUD_FALLBACK_URL=https://nexus-cloud-ee17.onrender.com

# Ссылка-приглашение на сервер NexusAI (футер, меню, лендинг)
VITE_DISCORD_INVITE_URL=https://discord.gg/your-invite-code

# Discord changelog (npm run changelog:notify) — do not commit secrets.
DISCORD_CHANGELOG_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANGELOG_CHANNEL_ID=1512107731862028443
DISCORD_GUILD_ID=1512107730427711498
