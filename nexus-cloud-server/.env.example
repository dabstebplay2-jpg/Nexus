# Polza.ai — основной провайдер ИИ (OAuth PKCE + backend/MCP)
POLZA_BACKEND_API_KEY=pza-your-backend-key-here
# POLZA_MCP_TOKEN=...  # токен с polza.ai/dashboard/mcp (keys.write + billing.read); иначе = POLZA_BACKEND_API_KEY
POLZA_APP_NAME=Nexus
# Прод: https://nexus-cloud-ee17.onrender.com/v1/auth/polza/callback
# Локально: http://127.0.0.1:8790/v1/auth/polza/callback
# POLZA_OAUTH_CALLBACK_URL=https://nexus-cloud-ee17.onrender.com/v1/auth/polza/callback
# DISCORD_OPS_WEBHOOK_URL=https://discord.com/api/webhooks/...  # ops-алерты «низкий баланс Polza»
# NEXUS_CRON_SECRET=...  # для POST /v1/internal/cron/polza-balance

# OpenRouter — бесплатные модели для тарифа FREE (только server env, не коммитить ключ)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://frontend-henna-tau-19.vercel.app
# OPENROUTER_APP_TITLE=Nexus
# NEXUS_FREE_OPENROUTER_DAILY_LIMIT=100
# NEXUS_FREE_OPENROUTER_RPM=15

# Legacy RouterAI (deprecated, можно удалить после миграции)
# ROUTER_AI_MASTER_KEY=sk-your-master-key-here
NEXUS_BILLING_TEST_MODE=false
# Тест: ULTRA всем, все модели, без квот, смена тарифа в UI (только локально, не на Render)
# NEXUS_TESTING_MODE=true

NEXUS_CLOUD_SECRET_KEY=generate-random-32-chars-minimum
# NEXUS_CLOUD_DATABASE_URL=sqlite:///./nexus_cloud_v2.db

# Внутренняя выдача тарифа (scripts/grant_tier.py) — отдельный ключ, НЕ мастер RouterAI
# NEXUS_ADMIN_GRANT_KEY=generate-random-grant-key-here

# Upstash Redis (на Render — аккаунты не слетают после деплоя)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Render API (опционально): scripts/setup_production.ps1 зальёт .env на сервер
# RENDER_API_KEY=rnd_...
# RENDER_ALLOW_SECRET_ROTATION=true  # только если нужно сгенерировать новый NEXUS_CLOUD_SECRET_KEY на Render

# Local admin UI (PC only)
# NEXUS_LOCAL_ADMIN=true
# NEXUS_ADMIN_PASSWORD=your-strong-admin-password
# NEXUS_ADMIN_DEFAULT_CLOUD_URL=https://frontend-henna-tau-19.vercel.app/api
# NEXUS_ADMIN_VERCEL_API_URL=https://frontend-henna-tau-19.vercel.app/api

# On Render: API for admin UI (same password as local)
# NEXUS_SUPPORT_NOTIFY_EMAIL=you@example.com
# NEXUS_REMOTE_ADMIN=true
# NEXUS_ADMIN_PASSWORD=your-strong-admin-password

# Прод: домены фронта через запятую
# NEXUS_CORS_ORIGINS=https://your-app.vercel.app

# Тарифы (USD; ₽ = курс ЦБ × price). Сбалансированная сетка: 10 / 20 / 100 / 200
# TIER_HOBBY_PRICE_USD=10
# TIER_STANDARD_PRICE_USD=20
# TIER_PRO_PRICE_USD=100
# TIER_ULTRA_PRICE_USD=200
# NEXUS_TIER_POOL_FRACTION=0.92
# NEXUS_DAILY_ABUSE_CAP_FRACTION=0

# Промокоды (NEXUS-ULTRA и т.д.): на проде false, локально true для тестов
# NEXUS_PROMO_CODES_ENABLED=false

# ЮKassa (оплата подписок)
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=live_...
# YOOKASSA_RETURN_PATH=/pricing
# NEXUS_FRONTEND_URL=https://frontend-henna-tau-19.vercel.app

# Email OTP (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Nexus <auth@yourdomain.com>
# NEXUS_AUTH_DEV_LOG_CODES=true

# Google OAuth (вход) — см. docs/GOOGLE_AUTH.md
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# Прод: callback через Vercel /api (тот же URL в Google Console → Authorized redirect URIs)
# GOOGLE_REDIRECT_URI=https://frontend-henna-tau-19.vercel.app/api/auth/google/callback
# NEXUS_FRONTEND_URL=https://frontend-henna-tau-19.vercel.app
# Локально: GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Коннекторы (отдельно от входа Google — Gmail/Calendar)
# GOOGLE_CONNECTOR_CLIENT_ID=...
# GOOGLE_CONNECTOR_CLIENT_SECRET=...
# GOOGLE_CONNECTOR_REDIRECT_URI=https://nexus-cloud-ee17.onrender.com/v1/connectors/google_workspace/callback
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# GITHUB_REDIRECT_URI=https://nexus-cloud-ee17.onrender.com/v1/connectors/github/callback
# VERCEL_CLIENT_ID=...
# VERCEL_CLIENT_SECRET=...
# VERCEL_REDIRECT_URI=https://nexus-cloud-ee17.onrender.com/v1/connectors/vercel/callback
# NEXUS_CONNECTOR_CALLBACK_BASE=https://frontend-henna-tau-19.vercel.app

# Telegram-бот — см. docs/TELEGRAM_BOT_RU.md
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_WEBHOOK_SECRET=случайная_строка
# TELEGRAM_BOT_USERNAME=NexusAI12Bot
# TELEGRAM_LOGIN_DOMAIN=frontend-henna-tau-19.vercel.app
# TELEGRAM_LINK_TTL_SEC=900
