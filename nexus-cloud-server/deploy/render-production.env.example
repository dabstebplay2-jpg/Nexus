# Шаблон production-переменных для существующего Render service `nexus-cloud`.
# Значения секретов НЕ коммитить. Скопируйте их в Render -> Environment.

ENV=production

# КРИТИЧНО: если сервис уже работал, сохранить старое значение без ротации.
NEXUS_CLOUD_SECRET_KEY=<keep-existing-secret-at-least-32-chars>
NEXUS_CLOUD_DATABASE_URL=postgresql://user:pass@host/db

# Frontend / CORS / OAuth return_to. Можно перечислить несколько Vercel origins через запятую.
NEXUS_FRONTEND_URL=https://your-production.vercel.app
NEXUS_CORS_ORIGINS=https://your-production.vercel.app,https://your-other-vercel-alias.vercel.app
NEXUS_OAUTH_REDIRECT_ORIGINS=https://your-production.vercel.app,https://your-other-vercel-alias.vercel.app

# Email OTP via Resend
NEXUS_EMAIL_AUTH_ENABLED=true
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Nexus <auth@your-domain.example>

# Google login (опционально, можно использовать параллельно email OTP)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://nexus-cloud-ee17.onrender.com/v1/auth/google/callback

# Polza AI: backend inference + MCP automatic per-user API keys
POLZA_BACKEND_API_KEY=pza-your-backend-key-here
POLZA_MCP_TOKEN=pza-mcp-token-here
POLZA_OAUTH_CALLBACK_URL=https://nexus-cloud-ee17.onrender.com/v1/auth/polza/callback
POLZA_APP_NAME=Nexus

# YooKassa subscriptions
YOOKASSA_SHOP_ID=...
YOOKASSA_SECRET_KEY=...
YOOKASSA_RETURN_PATH=/pricing
NEXUS_BILLING_TEST_MODE=false
NEXUS_TESTING_MODE=false

# Optional FREE-tier AI through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=
OPENROUTER_HTTP_REFERER=https://your-production.vercel.app
OPENROUTER_APP_TITLE=Nexus
NEXUS_FREE_OPENROUTER_DAILY_LIMIT=100
NEXUS_FREE_OPENROUTER_RPM=15

# Admin / persistence extras (optional)
NEXUS_REMOTE_ADMIN=true
NEXUS_ADMIN_PASSWORD=<strong-admin-password>
NEXUS_ADMIN_GRANT_KEY=<strong-grant-key>
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
