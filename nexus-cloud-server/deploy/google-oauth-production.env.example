# Скопируйте в nexus-cloud-server/.env (не коммитить) и заполните секреты.
# Затем: python scripts/sync_google_render_env.py

RENDER_API_KEY=rnd_...

GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Если Vercel /api даёт 404 — callback напрямую на Render (добавьте URI в Google Console):
# GOOGLE_REDIRECT_URI=https://nexus-cloud-bxcc.onrender.com/v1/auth/google/callback
GOOGLE_REDIRECT_URI=https://nexus-zeta-ruby-12.vercel.app/api/auth/google/callback
NEXUS_FRONTEND_URL=https://nexus-zeta-ruby-12.vercel.app
