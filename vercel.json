{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "framework": "vite",
  "rootDirectory": "frontend",
  "env": {
    "NEXUS_CLOUD_SERVER_URL": "https://nexus-cloud-bxcc.onrender.com",
    "VITE_CLOUD_FALLBACK_URL": "https://nexus-cloud-bxcc.onrender.com",
    "VITE_GOOGLE_AUTH_ENABLED": "true"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__subpath=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
